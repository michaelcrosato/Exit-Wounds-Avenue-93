    { "n": 27, "from": "F6.1", "need": "the pixel primitives, searched as games write them", "grep": ["^- `px\\.\\(disc\\|poly\\)"], "facts": ["px.disc(g, cx, cy, r, c)", "px.poly(g, pts, c)"] },
    { "n": 28, "from": "F6.1", "need": "the actions of the third-person preset", "grep": ["THIRDPERSON\\|input\\.use"], "facts": ["E.Input.THIRDPERSON { sprint, jump, crouch, interact, attack, block, dodge, use, map }", "up, down, left, right", "start, pause, confirm, cancel"] }
