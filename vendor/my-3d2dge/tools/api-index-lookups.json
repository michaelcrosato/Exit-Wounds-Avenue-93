{
  "about": "Lookups the API index must answer (D39): what the benchmark's agents read the engine's source for (F2.1, F3.1, F4.1), what the briefs and the kits need. Each is a search of API-INDEX.md as the handoff's README says to make it (grep -n \"<pattern>\" API-INDEX.md; \\| is or, . any character); facts are text its hits must hold, all of them. One search answers each but the 7th, which takes two (the class names its instance; the instance's lines hold the methods). node tools/api-index.mjs --check, and so doctrine-check, fails when one stops answering. Add a lookup an agent is seen to miss.",
  "lookups": [
    { "n": 1, "from": "F2.1", "need": "the state rig.update takes", "grep": ["rig.update"], "facts": ["aim", "crouch", "sprint", "climb", "hang", "flip", "pose: 'cheer'", "stance: 'guard' | 'ready'", "down: 0..1"] },
    { "n": 2, "from": "F2.1", "need": "the prop names for r.prop", "grep": ["r.prop\\|PROPS"], "facts": ["r.prop('torch'", "E.PROPS: torch", "barrel", "lantern", "mushroom"] },
    { "n": 3, "from": "F2.1, F3.1", "need": "the backdrop presets, and what sun takes", "grep": ["Backdrop"], "facts": ["E.Backdrop.presets", "castle-night", "sun, moon: { x, y (0..1 of the screen), r, color }"] },
    { "n": 4, "from": "F2.1", "need": "make something glow", "grep": ["emissive"], "facts": ["opts.emissive (0..1) makes it glow"] },
    { "n": 5, "from": "F2.1", "need": "px.blend's modes", "grep": ["px.blend"], "facts": ["'add'", "'multiply'", "'screen'"] },
    { "n": 6, "from": "F2.1, F3.1", "need": "the song format", "grep": ["audio.music"], "facts": ["bpm", "tracks", "wave: 'square'", "notes", "E.songs"] },
    { "n": 7, "from": "F2.1, F4.1", "need": "how an E.Attack is driven", "grep": ["E.Attack", "slash\\."], "facts": ["E.Attack: slash", "slash.start(", "slash.update(dt)", "slash.hits(", "slash.state"] },
    { "n": 8, "from": "F2.1, F4.1", "need": "what game.hitFx does", "grep": ["hitFx"], "facts": ["hit-stop", "shake", "sparks", "damage"] },
    { "n": 9, "from": "F2.1, F4.1", "need": "whether a dialog holds play", "grep": ["modal"], "facts": ["returns true while open and modal", "talk.modal"] },
    { "n": 10, "from": "F2.1, F4.1", "need": "the hats and hoods a rig wears", "grep": ["hood"], "facts": ["hat: 'cap' | 'band' | 'crown' | 'helmet' | 'pointed'", "hood: true"] },
    { "n": 11, "from": "F3.1", "need": "a cheer or kneel pose", "grep": ["cheer\\|kneel"], "facts": ["rig.update", "pose: 'cheer'", "'kneel'"] },
