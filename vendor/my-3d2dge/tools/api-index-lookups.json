    { "n": 14, "from": "F3.1", "need": "how a body collides and stands", "grep": ["body.update"], "facts": ["map.collide", "gravity", "map.groundAt"] },
    { "n": 15, "from": "F3.1", "need": "steer an E.Mover from code", "grep": ["mover.update"], "facts": ["ctl: game.input", "move: [dx, dy]"] },
    { "n": 16, "from": "F3.1", "need": "say with choices", "grep": ["talk.say"], "facts": ["choices: ['YES', 'NO']", "onChoice(i)"] },
    { "n": 17, "from": "F4.1", "need": "a pausable scene, hit-stop, the fade", "grep": ["pausable\\|hitstop\\|fade"], "facts": ["pausable", "game.hitstop", "game.fadeTime", "opts.fade"] },
