    { "n": 20, "from": "the Breath of the Wild brief", "need": "a stamina meter", "grep": ["stamina\\|meter"], "facts": ["bars: [{ label, value, max", "E.ui.bar(g, x, y, w, h", "stamina"] },
    { "n": 21, "from": "the Arkham brief", "need": "a takedown from behind", "grep": ["takedown"], "facts": ["mover.play('takedown', { other })", "E.targets"] },
    { "n": 22, "from": "the Arkham brief", "need": "guards that grow suspicious", "grep": ["Suspicion"], "facts": ["E.Suspicion: suspicion", "suspicion.update(dt, seen, target)", "'alert'"] },
