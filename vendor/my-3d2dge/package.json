    "assets:fetch": "node tools/asset-fetch.mjs",
    "assets:import": "node tools/asset-import.mjs",
    "assets:set": "node tools/asset-set.mjs",
    "assets:find": "node tools/asset-find.mjs",
    "test:stress": "node tools/stress-test.mjs",
    "test:lab3d": "node tools/lab3d-test.mjs",
    "test:stress-world": "node tools/stress-world-test.mjs",
    "test:kit3d": "node tools/kit3d-test.mjs",
    "test:determinism": "node tools/determinism-test.mjs",
    "test:replay": "node tools/replay-test.mjs",
